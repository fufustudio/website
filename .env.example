# Required for production URL, sitemap, canonicals, and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=

# Sanity CMS. Leave blank for credential-free local fallback work.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SANITY_STUDIO_URL=

# Rare escape hatch: set to true only when the standalone Studio intentionally
# edits a different Sanity project, dataset, or API version than the web app.
SANITY_ALLOW_CONFIG_MISMATCH=false

# Optional Sanity draft/live preview and webhook revalidation. Use a Viewer
# token for preview; never expose it through a NEXT_PUBLIC_* variable.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Required in production when the website message form is enabled.
# Server-only; never expose these in browser code.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Required in production by the contact route's shared abuse limiter.
# Server-only; create a Redis database in Upstash or Vercel Marketplace.
# Use either the UPSTASH_REDIS_* pair or Vercel Marketplace's KV_REST_API_* pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional Search Console verification token.
GOOGLE_SITE_VERIFICATION=

# Optional Google Analytics 4 Measurement ID. Paste only the G-... ID, not the
# full Google script snippet.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
