# Standalone Sanity Studio. These identify the same project and dataset used by
# NEXT_PUBLIC_SANITY_* in the web app.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-06-24
SANITY_STUDIO_PREVIEW_ORIGIN=

# Rare escape hatch shared with the web launch check. Prefer matching configs.
SANITY_ALLOW_CONFIG_MISMATCH=false
