{
  "name": "fufu-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "studio:dev": "npm --prefix studio run dev",
    "build": "next build",
    "studio:build": "npm --prefix studio run build",
    "studio:deploy": "npm --prefix studio run deploy",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css-types": "node -e \"require('node:fs').rmSync('.generated/css-types', { recursive: true, force: true })\" && tcm src --pattern \"**/*.module.css\" --allowArbitraryExtensions --outDir .generated/css-types && prettier --write \".generated/css-types/**/*.module.d.css.ts\"",
    "check:generated-clean": "node scripts/check-generated-clean.mjs",
    "components:validate": "node scripts/validate-component-structure.mjs",
    "typegen": "npm --prefix studio run typegen",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:analytics": "NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TEST NEXT_PUBLIC_GA_CONSENT_MODE=basic npm run build && ANALYTICS_E2E=true NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TEST NEXT_PUBLIC_GA_CONSENT_MODE=basic playwright test tests/e2e/analytics-consent.spec.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "template:clean": "node scripts/check-template-clean.mjs",
    "launch:check": "node scripts/check-launch-ready.mjs",
    "verify:quick": "npm run components:validate && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run format:check && npm run css-types && npm run typegen && npm run components:validate && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:template": "npm run verify && npm run studio:build && npm run check:generated-clean && node scripts/check-provider-disclosures.mjs && npm run template:clean",
    "verify:handoff": "npm run verify && npm run studio:build && npm run check:generated-clean && npm run launch:check && npm run test:e2e",
    "verify:release": "npm run verify:handoff && npm run lhci",
    "lhci": "lhci autorun",
    "analyze": "next experimental-analyze --output",
    "sanity:seed": "npm --prefix studio run seed",
    "sanity:seed:force": "npm --prefix studio run seed:force",
    "verify:content": "npm --prefix studio run validate-content",
    "sanity:repair-keys": "npm --prefix studio run repair-keys",
    "sanity:repair-keys:apply": "npm --prefix studio run repair-keys:apply"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.10",
    "@portabletext/react": "^6.2.0",
    "@react-email/render": "^2.0.0",
    "@sanity/client": "^7.25.0",
    "@sanity/image-url": "^2.1.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "groq": "^6.1.0",
    "lucide-react": "^1.22.0",
    "next": "^16.2.10",
    "next-sanity": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.16.0",
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@portabletext/markdown": "^1.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.3",
    "sharp": "^0.35.2",
    "svgo": "^4.0.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,mdx,yml,yaml}": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix --no-warn-ignored --no-error-on-unmatched-pattern",
    "src/**/*.module.css": "bash -c 'npm run css-types'"
  }
}
